# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Yahoo credentials are only needed once API access is approved. The free data
# layer (nflverse / Sleeper / RotoWire) and scripts/smoke_test.py run without
# any of these.

# From https://developer.yahoo.com/apps/ — app must request Fantasy Sports READ.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Yahoo REJECTS localhost redirect URIs. Use "oob" for a personal script:
# Yahoo displays a verifier code that you paste back into the terminal.
YAHOO_REDIRECT_URI=oob

# Where yahoo_oauth persists tokens. This file contains a LIVE REFRESH TOKEN.
# It is gitignored (oauth2.json, *token*.json). Treat a leak as account
# compromise: revoke at https://login.yahoo.com/account/security
YAHOO_TOKEN_FILE=oauth2.json

# Your league, e.g. 461.l.123456 (461 = 2025 NFL game key).
# Prefer resolving the current game key at runtime via /game/nfl.
YAHOO_LEAGUE_KEY=

# Local storage (defaults shown; both live under the gitignored data/ dir)
FF_DB_PATH=data/ff.sqlite
FF_CACHE_DIR=data/cache
FF_HTTP_TIMEOUT=20
