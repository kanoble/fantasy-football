# ---------------------------------------------------------------------------
# CREDENTIALS — never commit. This repo is public.
#
# The Yahoo OAuth libraries persist a LIVE REFRESH TOKEN to a JSON file in the
# working directory (yahoo_oauth writes oauth2.json by default). A refresh token
# is an account credential: it can be exchanged for access tokens until it is
# revoked or the account password changes. Treat a leak as an account
# compromise, not a config mistake.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
oauth2.json
*token*.json
private.json
secrets.json
credentials.json
*.pem
*.key

# ---------------------------------------------------------------------------
# Data, caches, and local state — regenerable, often large, sometimes derived
# from sources we are not licensed to redistribute.
# ---------------------------------------------------------------------------
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# nflverse / nflreadpy cache (NFLREADPY_CACHE_DIR, platformdirs default, and
# any in-repo cache we point it at)
.cache/
cache/
.nflreadpy/
nflreadpy_cache/
nflverse_cache/
.nflverse/

# Sleeper / HTTP response cache
.sleeper_cache/
sleeper_cache/
.http_cache/

